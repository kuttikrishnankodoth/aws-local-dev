#!/usr/bin/env bash
set -euo pipefail
caller_dir="$(pwd -P)"
for setting in AWS_CONFIG_FILE AWS_SHARED_CREDENTIALS_FILE; do
  value="${!setting:-}"
  if [[ -n "$value" && "$value" != /* ]]; then
    export "$setting=$caller_dir/$value"
  fi
done
cd "$(dirname "$0")"

action="${1:-}"
if [[ -z "$action" ]]; then
  if [[ ! -t 0 ]]; then
    echo "Pass --permanent, --transient, or --cleanup when running without a terminal." >&2
    exit 1
  fi
  printf 'What would you like to do?\n'
  printf '  1) Permanent setup (choose an installation folder)\n'
  printf '  2) Transient setup (temporary folder)\n'
  printf '  3) Clean up the existing setup\n'
  read -r -p 'Choose [1/2/3]: ' choice
  case "$choice" in
    1)
      action=--permanent
      read -r -p 'Installation folder [~/dev/aws-local-dev]: ' install_choice
      ;;
    2) action=--transient ;;
    3)
      read -r -p 'Remove local resources and the local-emulator profile? [y/N]: ' confirm
      case "$confirm" in
        y|Y|yes|YES) action=--cleanup ;;
        *) echo "Cleanup canceled."; exit 0 ;;
      esac
      ;;
    *) echo "Choose 1, 2, or 3." >&2; exit 1 ;;
  esac
fi

if ! command -v docker >/dev/null || ! docker info >/dev/null 2>&1; then
  echo "Start Docker Desktop and run ./aws-emulator-setup again." >&2
  exit 1
fi

if [[ "$action" == --cleanup ]]; then
  docker compose -p aws-local-dev down --volumes

  remove_profile_section() {
    local file="$1" target="$2" temp
    [[ -f "$file" ]] || return 0
    umask 077
    temp="$(mktemp "${file}.XXXXXX")"
    if awk -v target="$target" '
      /^[[:space:]]*\[/ {
        header = $0
        sub(/^[[:space:]]+/, "", header)
        sub(/\].*$/, "]", header)
        skip = (header == target)
      }
      !skip { print }
    ' "$file" > "$temp"; then
      mv -f "$temp" "$file"
    else
      rm -f "$temp"
      return 1
    fi
  }

  remove_profile_section "${AWS_CONFIG_FILE:-$HOME/.aws/config}" '[profile local-emulator]'
  remove_profile_section "${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}" '[local-emulator]'
  rm -f "$HOME/.aws/local-emulator/ca.pem"
  rmdir "$HOME/.aws/local-emulator" 2>/dev/null || true
  printf 'Removed the local Docker stack, volume, CLI profile, and TLS certificate.\n'
  exit 0
fi

if ! command -v aws >/dev/null; then
  echo "Install AWS CLI v2 and run ./aws-emulator-setup again." >&2
  exit 1
fi

configure_profile() (
  umask 077
  profile=local-emulator
  profile_dir="$HOME/.aws/local-emulator"
  mkdir -p "$profile_dir"
  staging_dir="$(mktemp -d "$profile_dir/setup.XXXXXX")"
  trap 'rm -rf "$staging_dir"' EXIT

  docker compose cp stackport:/emulator/9297/emulator_credentials "$staging_dir/credentials"
  docker compose cp stackport:/emulator/9297/ca.pem "$staging_dir/ca.pem"

  access_key="$(AWS_SHARED_CREDENTIALS_FILE="$staging_dir/credentials" AWS_CONFIG_FILE=/dev/null aws configure get aws_access_key_id --profile default)"
  secret_key="$(AWS_SHARED_CREDENTIALS_FILE="$staging_dir/credentials" AWS_CONFIG_FILE=/dev/null aws configure get aws_secret_access_key --profile default)"
  if [[ "$access_key" != EMULATOR* || -z "$secret_key" ]]; then
    echo "Expected emulator-generated credentials." >&2
    exit 1
  fi

  mv -f "$staging_dir/ca.pem" "$profile_dir/ca.pem"
  aws configure set endpoint_url https://127.0.0.1:9297 --profile "$profile"
  aws configure set region us-east-1 --profile "$profile"
  aws configure set ca_bundle "$profile_dir/ca.pem" --profile "$profile"
  aws configure set s3.addressing_style path --profile "$profile"
  aws configure set aws_access_key_id "$access_key" --profile "$profile"
  aws configure set aws_secret_access_key "$secret_key" --profile "$profile"

  unset AWS_ENDPOINT_URL AWS_ENDPOINT_URL_STS AWS_IGNORE_CONFIGURED_ENDPOINT_URLS AWS_CA_BUNDLE
  unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN
  account="$(aws --profile "$profile" --no-cli-pager sts get-caller-identity --query Account --output text)"
  if [[ "$account" != 000000000000 ]]; then
    echo "The CLI profile did not return the emulator account." >&2
    exit 1
  fi
)

install_dir="$HOME/dev/aws-local-dev"
source_dir="$(pwd -P)"
setup_files=(aws-emulator-setup compose.yaml Dockerfile README.md)

case "$action" in
  --permanent)
    mode=permanent
    install_dir="${2:-${install_choice:-$install_dir}}"
    case "$install_dir" in
      '~') install_dir="$HOME" ;;
      '~/'*) install_dir="$HOME/${install_dir:2}" ;;
      /*) ;;
      *) install_dir="$caller_dir/$install_dir" ;;
    esac
    ;;
  --transient) mode=transient ;;
  *) echo "Usage: $0 [--permanent [folder] | --transient | --cleanup]" >&2; exit 1 ;;
esac

if [[ "$mode" == transient ]]; then
  if [[ -f "$source_dir/.temporary-install" ]]; then
    install_dir="$source_dir"
  else
    install_dir="$(mktemp -d)"
    touch "$install_dir/.temporary-install"
  fi
fi
mkdir -p "$install_dir"
install_dir="$(cd "$install_dir" && pwd -P)"
if [[ "$source_dir" != "$install_dir" ]]; then
  backup_dir=
  for file in "${setup_files[@]}"; do
    destination="$install_dir/$file"
    if [[ -L "$destination" || ( -e "$destination" && ! -f "$destination" ) ]]; then
      printf 'Move this entry before installing: %s\n' "$destination" >&2
      exit 1
    fi
    if [[ -f "$destination" ]] && ! cmp -s "$file" "$destination"; then
      if [[ -z "$backup_dir" ]]; then
        backup_dir="$(mktemp -d "$install_dir/backup.XXXXXX")"
        printf 'Backing up changed setup files to %s\n' "$backup_dir"
      fi
      cp -p "$destination" "$backup_dir/"
    fi
  done
  cp -p "${setup_files[@]}" "$install_dir/"
fi
cd "$install_dir"
printf 'Setup folder: %s\n' "$install_dir"

docker compose up -d
url="http://127.0.0.1:${STACKPORT_UI_PORT:-8081}"
for ((attempt = 1; attempt <= 60; attempt++)); do
  if docker compose exec -T stackport python -c '
import ssl
from urllib.request import urlopen

context = ssl.create_default_context(cafile="/emulator/9297/ca.pem")
with urlopen("https://127.0.0.1:9297/__admin/health", context=context, timeout=2):
    pass
with urlopen("http://127.0.0.1:8080/", timeout=2):
    pass
' >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
if ((attempt > 60)); then
  echo "Services did not become ready. Inspect the logs below." >&2
  docker compose logs --tail=30 >&2
  exit 1
fi

configure_profile
printf 'AWS CLI profile: local-emulator\n'
printf 'StackPort: %s\nAWS Emulator: https://127.0.0.1:9297\n' "$url"
printf 'Reopen StackPort anytime while the stack is running: %s\n' "$url"
printf 'On macOS: open "%s"\n' "$url"
if command -v open >/dev/null; then
  open "$url" || true
fi
printf '\nSetup files: %s\n' "$install_dir"
for file in "${setup_files[@]}"; do
  printf '  %s/%s\n' "$install_dir" "$file"
done
printf 'AWS CLI config: %s\n' "${AWS_CONFIG_FILE:-$HOME/.aws/config}"
printf 'AWS CLI credentials: %s\n' "${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}"
printf 'Emulator TLS certificate: %s/.aws/local-emulator/ca.pem\n' "$HOME"
if [[ "$mode" == permanent ]]; then
  printf 'Run again: %q --permanent %q\n' "$install_dir/aws-emulator-setup" "$install_dir"
else
  printf 'Run again: %q --transient\n' "$install_dir/aws-emulator-setup"
fi
if [[ "$mode" == permanent ]]; then
  printf 'Clean up: %q --cleanup\n' "$install_dir/aws-emulator-setup"
  printf 'Cleanup instructions: %s/README.md (Destroy a permanent installation)\n' "$install_dir"
fi

cat <<'QUICK_START'

AWS CLI quick start
────────────────────────────────────────────────────────
Create an S3 bucket
  aws --profile local-emulator s3 mb s3://local-demo

List your S3 buckets
  aws --profile local-emulator s3 ls
────────────────────────────────────────────────────────
QUICK_START

if [[ -t 0 ]]; then
  read -r -p 'Use the local-emulator profile in this shell without typing --profile? [y/N]: ' use_local_profile || use_local_profile=
  case "$use_local_profile" in
    y|Y|yes|YES)
      unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN
      unset AWS_DEFAULT_PROFILE AWS_CA_BUNDLE AWS_IGNORE_CONFIGURED_ENDPOINT_URLS
      while IFS= read -r variable; do
        unset "$variable"
      done < <(compgen -A variable AWS_ENDPOINT_URL)
      export AWS_PROFILE=local-emulator
      export TF_VAR_expected_account_id=000000000000
      printf '\nLocal AWS shell. Type exit to return to your original shell.\n'
      printf 'Try: aws s3 mb s3://local-demo\n     aws s3 ls\n'
      if [[ -n "${SHELL:-}" && -x "$SHELL" ]]; then
        exec "$SHELL" -i
      fi
      exec bash -i
      ;;
  esac
fi
